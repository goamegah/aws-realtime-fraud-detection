# Example environment variables for local development (do not commit real secrets)

# --- AWS & Solution ---
AWS_REGION="eu-west-1"
SPARK_SOLUTION_S3_BUCKET=""  # Auto-set by 'make env.sync' from Terraform output
SPARK_SOLUTION_NAME=""
SOLUTIONS_S3_BUCKET=""       # Auto-set by 'make env.sync' from Terraform output
SOLUTION_NAME="fraud-detection"
SECRETS_MANAGER_ID=""        # optional, used in prod

# NOTE: Do NOT put AWS credentials here. Use ~/.aws/credentials or IAM roles instead.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should be configured via:
#   - aws configure
#   - Environment variables (export AWS_ACCESS_KEY_ID=...)
#   - IAM instance roles (on EC2/Lambda/ECS)

# --- Chalice API ---
# Lambda environment variables names are lowercase as used in app/chalice/app.py
stream_name=""              # Auto-set by 'make env.sync' from Terraform output
solution_prefix="fraud-detection"
aws_region="eu-west-1"

# --- Local streaming job (Spark/Glue compatible) ---
KINESIS_STREAM=""           # Auto-set by 'make env.sync' from Terraform output
POSTGRES_HOST=""            # Auto-set by 'make env.sync' from Terraform output
POSTGRES_PORT="5432"        # Auto-set by 'make env.sync' from Terraform output
POSTGRES_DB="fraudit_postgres_db"
POSTGRES_USER="postgres_user"
POSTGRES_PASSWORD="postgres_password"

# Optional paths
KINESIS_CONNECTOR_PATH="src/resources/spark-streaming-sql-kinesis-connector_2.12-1.0.0.jar"
CHECKPOINT_PATH="/tmp/fraudit-checkpoint"

# --- Use Chalice output API_URL after performing <chalice deploy> command ---
CHALICE_API_URL="https://xxxxx.execute-api.eu-west-1.amazonaws.com/api"